# For a local demo you need none of this: scripts\dev-local.ps1 sets everything itself.
# These are for running against Zero once its chain ID and RPC are public. Contract addresses come from contracts\deployments\<chainId>.json.

# Indexer and keeper
CHAIN_ID=
RPC_URL=
SYNC_TAG=finalized
PORT=3001
CORS_ORIGIN=http://localhost:3000
KEEPER_PRIVATE_KEY=

# Deploy only
PRIVATE_KEY=

# Web, in web\.env.local
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_API_URL=http://localhost:3001
